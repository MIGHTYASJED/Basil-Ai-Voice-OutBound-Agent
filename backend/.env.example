# ─── Core ───────────────────────────────────────────────────────────
PORT=4000
BRIDGE_PORT=4001
JWT_SECRET=change-me-to-a-long-random-string-in-production
DATABASE_URL="file:./basil.db"
PUBLIC_BASE_URL=http://localhost:4000
PUBLIC_BRIDGE_WS_URL=ws://localhost:4001

# ─── Call simulation ────────────────────────────────────────────────
# When TELEPHONY_MODE=simulation, calls are fully simulated end-to-end
# (no real carrier needed). Switch to "live" once you add a provider's
# credentials below. Every other part of the system behaves identically.
TELEPHONY_MODE=simulation
DEFAULT_PROVIDER=telnyx
# Per-number daily call cap (spam protection)
NUMBER_DAILY_CALL_CAP=200
# Max time a driver can sit parked in the dispatcher queue (seconds)
MAX_PARK_SECONDS=180

# ─── Gemini Live (AI voice) ─────────────────────────────────────────
# Add your key to enable the real AI voice. With a key set, the "Test Agent"
# button in Mission Control lets you talk to the agent live from your browser
# (mic → Gemini → speakers) — this works even while TELEPHONY_MODE=simulation,
# because it doesn't use a carrier. Driver calls still need a carrier (below).
# Leave blank to keep the AI fully simulated (scripted conversations).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview

# ─── Telnyx (primary carrier) ───────────────────────────────────────
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=

# ─── Twilio (fallback carrier) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ─── Vapi (alternative, agent-managed mode) ─────────────────────────
VAPI_API_KEY=

# ─── DAT freight feed (optional) ────────────────────────────────────
DAT_API_KEY=
